{
  "test_cases": [
    {
      "id": 1,
      "description": "Normal async API call with legacy vs modern patterns",
      "input": {
        "url": "https://api.example.com/data",
        "timeout": 5
      },
      "expected_output": {
        "status": "success",
        "data": {"result": "sample"}
      },
      "compatibility_issue": "asyncio.coroutine decorator (removed in Python 3.11) vs async/await",
      "test_type": "normal"
    },
    {
      "id": 2,
      "description": "Type hints compatibility - typing.List vs built-in list",
      "input": {
        "items": [1, 2, 3, 4, 5]
      },
      "expected_output": {
        "sum": 15,
        "count": 5
      },
      "compatibility_issue": "typing.List (deprecated in 3.9+) vs built-in list",
      "test_type": "normal"
    },
    {
      "id": 3,
      "description": "Collections module import compatibility",
      "input": {
        "config": {"key1": "value1"},
        "overrides": {"key2": "value2"}
      },
      "expected_output": {
        "merged": {"key1": "value1", "key2": "value2"}
      },
      "compatibility_issue": "collections.Mapping (removed in 3.10) vs collections.abc.Mapping",
      "test_type": "boundary"
    },
    {
      "id": 4,
      "description": "Event loop management across Python versions",
      "input": {
        "tasks": ["task1", "task2", "task3"]
      },
      "expected_output": {
        "completed": 3
      },
      "compatibility_issue": "asyncio.get_event_loop() (deprecated 3.10+) vs asyncio.run()",
      "test_type": "normal"
    },
    {
      "id": 5,
      "description": "Complex nested async operations with error handling",
      "input": {
        "operations": [
          {"type": "fetch", "url": "http://example1.com"},
          {"type": "process", "data": [1, 2, 3]},
          {"type": "save", "path": "/tmp/result.txt"}
        ]
      },
      "expected_output": {
        "success": true,
        "operations_completed": 3
      },
      "compatibility_issue": "Old exception handling vs modern context preservation",
      "test_type": "complex"
    },
    {
      "id": 6,
      "description": "Edge case - Empty list handling",
      "input": {
        "items": []
      },
      "expected_output": {
        "sum": 0,
        "count": 0
      },
      "compatibility_issue": "Robustness - empty input handling",
      "test_type": "edge"
    },
    {
      "id": 7,
      "description": "Edge case - None inputs",
      "input": {
        "config": null,
        "overrides": null
      },
      "expected_output": {
        "merged": {}
      },
      "compatibility_issue": "Robustness - None handling",
      "test_type": "edge"
    },
    {
      "id": 8,
      "description": "Invalid input - Malformed operation",
      "input": {
        "operations": [
          {"bad_key": "bad_value"}
        ]
      },
      "expected_output": {
        "success": false,
        "errors": ["Operation missing 'type' field"]
      },
      "compatibility_issue": "Input validation and error reporting",
      "test_type": "invalid"
    },
    {
      "id": 9,
      "description": "Invalid input - Unknown operation type",
      "input": {
        "operations": [
          {"type": "unknown_op"}
        ]
      },
      "expected_output": {
        "success": false,
        "errors": ["Unknown operation type: unknown_op"]
      },
      "compatibility_issue": "Error handling for unexpected inputs",
      "test_type": "invalid"
    },
    {
      "id": 10,
      "description": "Performance - Concurrent vs sequential execution",
      "input": {
        "tasks": ["task1", "task2", "task3", "task4", "task5", "task6", "task7", "task8", "task9", "task10"]
      },
      "expected_output": {
        "completed": 10
      },
      "compatibility_issue": "Sequential event loop vs asyncio.gather concurrent execution",
      "test_type": "performance"
    }
  ]
}
