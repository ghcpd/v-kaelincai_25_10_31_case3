{
  "test_cases": [
    {
      "id": 1,
      "description": "Normal async API call with modern async/await",
      "input": {
        "url": "https://api.example.com/data",
        "timeout": 5
      },
      "expected_output": {
        "status": "success",
        "data": {"result": "sample"}
      },
      "compatibility_issue": "Fixed: Uses modern async/await instead of deprecated @asyncio.coroutine"
    },
    {
      "id": 2,
      "description": "Type hints using modern built-in list",
      "input": {
        "items": [1, 2, 3, 4, 5]
      },
      "expected_output": {
        "sum": 15,
        "count": 5
      },
      "compatibility_issue": "Fixed: Uses built-in list instead of typing.List"
    },
    {
      "id": 3,
      "description": "Dict union with collections.abc.Mapping",
      "input": {
        "config": {"key1": "value1"},
        "overrides": {"key2": "value2"}
      },
      "expected_output": {
        "merged": {"key1": "value1", "key2": "value2"}
      },
      "compatibility_issue": "Fixed: Uses collections.abc.Mapping with None handling"
    },
    {
      "id": 4,
      "description": "Modern asyncio task execution",
      "input": {
        "tasks": ["task1", "task2", "task3"]
      },
      "expected_output": {
        "completed": 3
      },
      "compatibility_issue": "Fixed: Uses asyncio.gather and asyncio.run()"
    },
    {
      "id": 5,
      "description": "Complex nested async with modern exception handling",
      "input": {
        "operations": [
          {"type": "fetch", "url": "http://example1.com"},
          {"type": "process", "data": [1, 2, 3]},
          {"type": "save", "path": "/tmp/result.txt"}
        ]
      },
      "expected_output": {
        "success": true,
        "operations_completed": 3
      },
      "compatibility_issue": "Fixed: Modern exception chaining with validation"
    }
  ]
}
