{
  "case_01_schema_upgrade": {
    "description": "Schema version 2.0 introduces OS-specific artifact map incompatible with v1 parser.",
    "compatibility_issue": "API schema version mismatch",
    "input": "{\"schema_version\": \"2.0\", \"name\": \"demo-app\", \"artifacts\": {\"posix\": {\"path\": \"linux.tar.gz\", \"hash\": \"abc\"}}, \"hash\": \"legacy\", \"hooks\": []}",
    "expected_outcome": "fail",
    "expected_error_type": "CompatibilityError"
  },
  "case_02_non_string_payload": {
    "description": "Newer clients send parsed dict instead of raw JSON string.",
    "compatibility_issue": "Input type assumption",
    "input": {
      "schema_version": "1.0",
      "name": "demo-app",
      "artifact_path": "bundle.zip",
      "hash": "deadbeef",
      "hooks": []
    },
    "expected_outcome": "fail",
    "expected_error_type": "TypeError"
  },
  "case_03_nested_hook_objects": {
    "description": "Hooks are now structured objects, old parser expects colon separated strings.",
    "compatibility_issue": "Protocol change in hooks",
    "input": "{\"schema_version\": \"1.0\", \"name\": \"demo-app\", \"artifact_path\": \"bundle.zip\", \"hash\": \"deadbeef\", \"hooks\": [{\"name\": \"install\", \"path\": \"scripts/install.sh\"}]}",
    "expected_outcome": "fail",
    "expected_error_type": "ValueError"
  },
  "case_04_windows_path_mapping": {
    "description": "Backslash replacement fails when running on POSIX target.",
    "compatibility_issue": "OS-specific path normalization",
    "target_os": "posix",
    "input": "{\"schema_version\": \"1.0\", \"name\": \"demo-app\", \"artifact_path\": \"C:/app/bundle.zip\", \"hash\": \"deadbeef\", \"hooks\": [\"install:C:/hooks/install.bat\"]}",
    "expected_outcome": "pass"
  },
  "case_05_large_payload": {
    "description": "Large but valid schema 1.0 payload should succeed despite metadata bloat.",
    "compatibility_issue": "Performance stress",
    "input": "{\"schema_version\": \"1.0\", \"name\": \"demo-app\", \"artifact_path\": \"bundle.zip\", \"hash\": \"deadbeef\", \"hooks\": [\"install:scripts/install.sh\"], \"metadata\": {\"padding\": \"\"}}",
    "expected_outcome": "pass"
  }
}