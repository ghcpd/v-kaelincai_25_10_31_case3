[
  {
    "name": "normal_case",
    "input": {
      "records": [
        {"id": "A", "timestamp": "2025-10-31+00:00", "payload": {"value": 1}},
        {"id": "b", "timestamp": "2025-10-31+00:00", "payload": {"value": 2}}
      ]
    },
    "expected_output": {
      "record_count": 2,
      "ids": ["A", "b"],
      "payload_digest": null
    },
    "issue_type": "baseline",
    "should_pass_faulty": true,
    "should_pass_optimized": true
  },
  {
    "name": "timezone_Z_case",
    "input": {
      "records": [
        {"id": "tz1", "timestamp": "2025-10-31Z", "payload": {"value": 10}},
        {"id": "tz2", "timestamp": "2025-10-31+00:00", "payload": {"value": 20}}
      ]
    },
    "expected_output": {
      "record_count": 2,
      "ids": ["tz1", "tz2"],
      "payload_digest": null
    },
    "issue_type": "timezone parsing incompatibility (fromisoformat vs Z suffix)",
    "should_pass_faulty": false,
    "should_pass_optimized": true
  },
  {
    "name": "non_string_id_case",
    "input": {
      "records": [
        {"id": 101, "timestamp": "2025-10-31+00:00", "payload": {"value": 5}},
        {"id": "x", "timestamp": "2025-10-31+00:00", "payload": {"value": 6}}
      ]
    },
    "expected_output": {
      "record_count": 2,
      "ids": ["101", "x"],
      "payload_digest": null
    },
    "issue_type": "type handling / non-string IDs",
    "should_pass_faulty": false,
    "should_pass_optimized": true
  },
  {
    "name": "malformed_missing_id",
    "input": {
      "records": [
        {"timestamp": "2025-10-31+00:00", "payload": {"value": 7}}
      ]
    },
    "expected_output": {
      "record_count": 1,
      "ids": [],
      "payload_digest": null
    },
    "issue_type": "validation / missing id",
    "should_pass_faulty": false,
    "should_pass_optimized": false
  },
  {
    "name": "large_payload_case",
    "input": {
      "records": [
        {"id": "id_0", "timestamp": "2025-10-31+00:00", "payload": {"value": 0}},
        {"id": "id_1", "timestamp": "2025-10-31+00:00", "payload": {"value": 1}},
        {"id": "id_2", "timestamp": "2025-10-31+00:00", "payload": {"value": 2}}
      ]
    },
    "expected_output": {
      "record_count": 100,
      "payload_digest": null
    },
    "issue_type": "performance / ordering stability",
    "should_pass_faulty": true,
    "should_pass_optimized": true,
    "generate_dynamic": {
      "count": 100,
      "template": {"timestamp": "2025-10-31+00:00", "payload": {"value_base": 0}}
    }
  },
  {
    "name": "nested_complex_case",
    "input": {
      "records": [
        {"id": "N1", "timestamp": "2025-10-31Z", "payload": {"deep": {"a": 1, "b": [3,2,1]}}},
        {"id": "N2", "timestamp": "2025-10-31+00:00", "payload": {"deep": {"b": [1,2,3], "a": 2}}}
      ]
    },
    "expected_output": {
      "record_count": 2,
      "ids": ["N1", "N2"],
      "payload_digest": null
    },
    "issue_type": "nested logic + timezone",
    "should_pass_faulty": false,
    "should_pass_optimized": true
  }
]
