[
  {
    "name": "normal_v2_response",
    "input": {
      "batch": [
        {
          "task_id": "task-normal-001",
          "payload": {"value": 21},
          "priority": 1,
          "metadata": {"source": "sensor-a", "labels": ["nominal"]}
        }
      ]
    },
    "expected_output": {
      "status": "ok",
      "detail": "processed",
      "completed_at": "2025-10-31T12:30:00Z"
    },
    "compatibility_issue": "API version mismatch between v1 client and v2 server schema",
    "expected_result": "success"
  },
  {
    "name": "rate_limited_v2",
    "input": {
      "batch": [
        {
          "task_id": "task-rate-002",
          "payload": {"value": 10},
          "priority": 3,
          "metadata": {"source": "sensor-b", "labels": ["burst"]}
        }
      ]
    },
    "expected_output": {
      "status": "retry",
      "retry_after": 30
    },
    "compatibility_issue": "Header negotiation missing resulting in HTTP 400 with structured error payload",
    "expected_result": "success"
  },
  {
    "name": "timestamp_edge_case",
    "input": {
      "batch": [
        {
          "task_id": "task-time-003",
          "payload": {"value": 0},
          "priority": 5,
          "metadata": {"source": "sensor-c", "labels": ["edge", "timestamp"]}
        }
      ]
    },
    "expected_output": {
      "status": "ok",
      "completed_at": "2025-10-31T00:00:00Z"
    },
    "compatibility_issue": "RFC3339 timestamps not convertible to epoch integers",
    "expected_result": "success"
  },
  {
    "name": "malformed_payload",
    "input": {
      "batch": [
        {
          "task_id": "task-bad-004",
          "payload": null,
          "priority": 2,
          "metadata": {"source": "sensor-d", "labels": ["invalid"]}
        }
      ]
    },
    "expected_output": {
      "status": "error",
      "detail": "invalid payload"
    },
    "compatibility_issue": "Server returns structured validation errors with nested objects",
    "expected_result": "success"
  },
  {
    "name": "complex_nested_batch",
    "input": {
      "batch": [
        {
          "task_id": "task-nested-005",
          "payload": {"value": [1, 2, {"deep": "value"}]},
          "priority": 1,
          "metadata": {"source": "sensor-e", "labels": ["complex"], "extra": {"tz": "Asia/Tokyo"}}
        }
      ]
    },
    "expected_output": {
      "status": "ok",
      "metrics": {"latency_ms": 12.5}
    },
    "compatibility_issue": "Nested metrics containing floats serialized as strings cause type casting mismatches",
    "expected_result": "success"
  }
]
